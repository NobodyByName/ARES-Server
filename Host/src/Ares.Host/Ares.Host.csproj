<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Ares.Host</RootNamespace>
    <OutputType>Exe</OutputType>
    <AssemblyName>ARES-Host</AssemblyName>
    <Description>ARES-Host is the ARC Raiders backend: sign-in, main menu, party, matchmaking and raid assignment.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ares.Host.Tests" />
    <EmbeddedResource Include="../../ares-host.conf.dist" LogicalName="Ares.Host.ares-host.conf.dist" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../ares-host.conf.dist" Link="ares-host.conf.dist" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ares.Host.Services/Ares.Host.Services.csproj" />
  </ItemGroup>

</Project>
