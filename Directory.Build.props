<Project>
  <!--
    Shared build settings. Each component folder (Structs, Common, Host, Raid, MapData) has its own
    Directory.Build.props that names the component, lists the components it may depend on and
    imports this file.
  -->
  <PropertyGroup>
    <AresRepositoryRoot>$(MSBuildThisFileDirectory)</AresRepositoryRoot>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Product>ARES</Product>
    <Authors>ARES contributors</Authors>
    <Company>ARES</Company>
    <PathMap>$(AresRepositoryRoot)=/_/ARES-Server/</PathMap>
    <IsPackable>false</IsPackable>
    <AresAllowPackages Condition="'$(AresAllowPackages)' == ''">true</AresAllowPackages>
  </PropertyGroup>

  <!--
    Version: YYYYMMDDNN, the release date plus a two-digit counter for releases on that day
    (2026110201, 2026110202, ...). Change only AresVersion; it is the only version shown to people.
    .NET version parts cannot exceed 65534, so the assembly and file versions stay 1.0.0.0.
  -->
  <PropertyGroup>
    <AresVersion>2026110201</AresVersion>
    <AresVersionValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(AresVersion)', '^20[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])(0[1-9]|[1-9][0-9])$'))</AresVersionValid>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AresVersionValid)' == 'true'">
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>$(AresVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <Target Name="AresCheckVersion" BeforeTargets="BeforeBuild" Condition="'$(AresVersionValid)' != 'true'">
    <Error Text="AresVersion '$(AresVersion)' is not YYYYMMDDNN (a date followed by a counter from 01)." />
  </Target>

  <!-- Test projects are the ones named *.Tests. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <AresIsTest>true</AresIsTest>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
</Project>
